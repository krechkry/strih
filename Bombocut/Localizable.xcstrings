    "Subject tracking, masks, motion blur, smooth slow motion, effects.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování objektů, masky, rozmazání pohybem, plynulé zpomalení, efekty."
          }
        }
      }
    },
    "Subtitles in 25 languages": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky ve 25 jazycích"
          }
        }
      }
    },
    "Subtitles in 25 languages, made on your iPhone. Everything runs offline: no cloud, no account, no data collection. Just the app, your battery and your chip.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky ve 25 jazycích, vytvořené přímo v iPhonu. Všechno běží offline: žádný cloud, žádný účet, žádné sbírání dat. Jen aplikace, tvoje baterka a tvůj čip."
          }
        }
      }
    },
    "Taking long (%@). Tap to restart": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvá to dlouho (%@). Klepni pro restart"
          }
        }
      }
    },
