    "Both clips move together while one hands over to the other, so the video gets shorter by the length of the transition.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba klipy se během přechodu pohybují spolu, takže se video zkrátí o délku přechodu."
          }
        }
      }
    },
    "Both ways": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oběma směry"
          }
        }
      }
    },
