{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ %lld %%": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld %%"
          }
        }
      }
    },
    "%@ translates offline, on your iPhone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ překládá offline, přímo v iPhonu."
          }
        }
      }
    },
    "%@, downloaded once. Wi-Fi recommended.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, stahuje se jen jednou. Doporučujeme Wi-Fi."
          }
        }
      }
    },
    "%lld chars": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld znaků"
          }
        }
      }
    },
    "%lld clip": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klip"
          }
        }
      }
    },
    "%lld clips": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klipů"
          }
        }
      }
    },
    "%lld days of your trial left.": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývá %lld den."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývají %lld dny."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývá %lld dní."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývá %lld dní."
                }
              }
            }
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybrán %lld"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybrány %lld"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybráno %lld"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybráno %lld"
                }
              }
            }
          }
        }
      }
    },
    "1 day of your trial left.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební verze: zbývá poslední den."
          }
        }
      }
    },
    "1 line": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1 řádek"
          }
        }
      }
    },
    "2 lines": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "2 řádky"
          }
        }
      }
    },
    "25 languages": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "25 jazyků"
          }
        }
      }
    },
    "A short Made with BOMBOCUT card after your last clip. Thanks for spreading the word!": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátká karta „Made with BOMBOCUT“ po posledním klipu. Díky, že o nás dáváš vědět!"
          }
        }
      }
    },
    "A slow push in or pull out over the whole clip, like a camera move. Switch it on to set it up.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalé přiblížení nebo oddálení přes celý klip, jako pohyb kamery. Zapni a nastav."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikaci"
          }
        }
      }
    },
    "About %.0f MB for %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhruba %.0f MB na %@."
          }
        }
      }
    },
    "Above 4096 px only HEVC works.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad 4096 px funguje jen HEVC."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat"
          }
        }
      }
    },
    "Add %lld": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat %lld"
          }
        }
      }
    },
