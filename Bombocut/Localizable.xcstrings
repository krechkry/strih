            "value": "Vítr, provoz, brum i ozvěna pryč, hlas zůstane."
          }
        }
      }
    },
    "With this off, you can still sync single projects: hold one on Home and tap Sync.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I když je tohle vypnuté, můžeš synchronizovat jednotlivé projekty: podrž prst na projektu v seznamu a klepni na Synchronizovat."
          }
        }
      }
    },
