    "Goes on top of each clip's own speed (their speed curves keep their shape). Keyframes stay on the same moments.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá se k vlastní rychlosti každého klipu (jejich křivky rychlosti si nechají tvar). Keyframy zůstanou na stejných momentech."
          }
        }
      }
    },
    "Goes to every clip in the stack.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro všechny klipy ve Stacku."
          }
        }
      }
    },
    "Gone for good in %lld days": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dní do trvalého smazání: %lld"
