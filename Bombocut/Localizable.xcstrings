      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádkování"
          }
        }
      }
    },
    "Linear": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineárně"
          }
        }
      }
    },
    "Lines": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádky"
          }
        }
      }
    },
    "Listen to": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky z"
          }
        }
      }
    },
    "Listening %lld %%": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepisuju %lld %%"
          }
        }
      }
    },
    "Listens to this clip only. Captions on the other clips stay as they are.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíše jen tenhle klip. Titulky na ostatních klipech zůstanou, jak jsou."
          }
        }
      }
    },
    "Loading voice model": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítám hlasový model"
          }
        }
      }
    },
    "Locked": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamčeno"
          }
        }
      }
    },
    "Locked on the subject: the picture moves so it stays still, everything else moves around it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamčeno na objektu: obraz se posouvá tak, aby objekt stál, a všechno ostatní se hýbe kolem něj."
          }
        }
      }
    },
    "Look of the overlay": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhled překrytí"
          }
        }
      }
    },
    "Luminance": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlost"
          }
        }
      }
    },
    "MPEG-1/MPEG-2 video (DVD and hard disk camcorders) can't be played on iPhone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Video MPEG-1/MPEG-2 (DVD a kamery s pevným diskem) iPhone neumí přehrát."
          }
        }
      }
    },
    "Made by a filmmaker in Czechia.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od jednoho filmaře z Česka."
          }
        }
      }
    },
