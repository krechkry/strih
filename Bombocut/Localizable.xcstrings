    "Finds people (fast) or any main subject in every frame, on your iPhone. Then blur, darken or drain the color from everything else, or put text behind the subject.": {
      "localizations": {
        "cs": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Najde v každém snímku lidi (rychle) nebo hlavní objekt, přímo v iPadu. Zbytek pak můžeš rozmazat, ztmavit nebo odbarvit, nebo dát text za objekt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
