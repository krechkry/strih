          "stringUnit": {
            "state": "translated",
            "value": "Šířka"
          }
        }
      }
    },
    "Wind, traffic, hum and room echo out, the voice stays.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vítr, provoz, brum a ozvěna místnosti pryč, hlas zůstane."
          }
