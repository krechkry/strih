    "Later": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Později"
          }
        }
      }
    },
    "Layout": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout"
          }
        }
      }
    },
    "Leave it empty to keep “%@”. You can rename it after export.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když to necháš prázdné, zůstane „%@“. Přejmenovat ho můžeš i po exportu."
          }
        }
      }
    },
    "Leftovers from stopped downloads": {
      "localizations": {
        "cs": {
          "stringUnit": {
