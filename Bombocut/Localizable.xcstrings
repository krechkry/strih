    },
    "Better translations and more languages, Czech and Slovak too. Works offline. One download, %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepší překlady a víc jazyků, i čeština a slovenština. Funguje offline. Stáhne se jednou, %@."
          }
        }
      }
    },
