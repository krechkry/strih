    "Everything runs on your iPhone. The cleaned sound is made once and kept, so playback and export use it right away.": {
      "localizations": {
        "cs": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Všechno běží v iPadu. Vyčištěný zvuk se spočítá jednou a uloží, takže ho přehrávání i export hned použijí."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Všechno běží v iPhonu. Vyčištěný zvuk se spočítá jednou a uloží, takže ho přehrávání i export hned použijí."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Everything runs on your iPad. The cleaned sound is made once and kept, so playback and export use it right away."
                }
              },
              "other": {
