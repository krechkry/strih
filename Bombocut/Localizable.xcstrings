        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepnout můžeš kdykoli v Nastavení."
          }
        }
      }
    },
    "You can turn it off for this export. The full version remembers your choice.": {
      "localizations": {
        "cs": {
