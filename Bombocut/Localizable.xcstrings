            "state": "translated",
            "value": "Čekám na internet · %lld %%"
          }
        }
      }
    },
    "Warming up the model (first time can take a minute)…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se připravuje (poprvé to chvíli trvá)…"
          }
        }
      }
    },
    "Which languages do you speak in your videos? One speech model covers all 25. Captions then run on your iPhone, offline.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakými jazyky ve videích mluvíš? Jeden hlasový model zvládne všech 25. Titulky pak běží v iPhonu, offline."
          }
        }
      }
    },
    "Whole clip": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý klip"
          }
        }
      }
    },
    "Whole layer": {
