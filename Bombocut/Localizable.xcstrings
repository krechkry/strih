    "Smooth cut morphs one shot into the next, so a jump cut in similar footage (someone talking, the same spot) does not jump. Keep it short.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plynulý střih přelije jeden záběr do druhého, takže střih v podobných záběrech (někdo mluví, pořád stejné místo) neposkočí. Nech ho krátký."
          }
        }
      }
    },
