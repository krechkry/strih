    "Finds people (fast) or any main subject in every frame, on your iPhone. Then blur, darken or drain the color from everything else, or put text behind the subject.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najde lidi (rychle) nebo hlavní objekt v každém snímku, přímo v iPhonu. Pak můžeš zbytek rozmazat, ztmavit nebo odbarvit, nebo dát text za objekt."
          }
        }
      }
    },
    "First time downloads the speech model (%@). Wi-Fi recommended.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprvé se stáhne hlasový model (%@). Doporučujeme Wi-Fi."
