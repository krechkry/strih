      }
    },
    "Hendrik Schröter. Noise removal for speech, converted to Core ML by aufklarer. License: MIT / Apache 2.0.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hendrik Schröter. Odstranění šumu z řeči, převedeno do Core ML (aufklarer). Licence: MIT / Apache 2.0."
          }
        }
      }
    },
    "Highlight": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvýraznění"
          }
        }
      }
    },
    "Highlight colors the word being said (the Highlight animation).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvýraznění obarví slovo, které zrovna zazní (animace Zvýraznění)."
          }
        }
      }
    },
    "Highlights": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světla"
          }
        }
      }
    },
    "Hold and slide the sound on the timeline to move it; drag its edges to trim.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž zvuk a posuň ho po timeline, tažením okrajů ho zkrátíš."
          }
        }
      }
    },
    "Hold to see without effects": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž a uvidíš to bez efektů"
          }
        }
      }
    },
    "Holds the shot still as if on a tripod. Where the camera really moves, it follows as little as the zoom allows.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drží záběr na místě jako ze stativu. Kde se kamera opravdu hýbe, jde za ní jen tolik, kolik přiblížení dovolí."
          }
        }
      }
    },
    "How much do you want to see?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik toho chceš vidět?"
          }
        }
      }
    },
    "Hue": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstín"
          }
        }
      }
    },
    "Import failed": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Import selhal"
          }
        }
      }
    },
    "Imported": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importy"
          }
        }
      }
    },
    "Imported videos no project uses any more": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importovaná videa, která už žádný projekt nepoužívá"
          }
        }
      }
    },
    "Importing…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuju…"
          }
        }
      }
    },
    "In": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příchod"
          }
        }
      }
    },
    "In / out": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příchod / odchod"
          }
        }
      }
    },
    "In frame": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V záběru"
          }
        }
      }
    },
