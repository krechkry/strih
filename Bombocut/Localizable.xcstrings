            "state": "translated",
            "value": "Žlutá"
          }
        }
      }
    },
    "You can close this and keep editing. The pill at the top shows when they're ready.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klidně to zavři a stříhej dál. Až budou titulky hotové, uvidíš to nahoře."
          }
        }
      }
    },
    "You can switch any time in Settings.": {
