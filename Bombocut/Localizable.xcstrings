    "Welcome to Bombocut": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vítej v Bombocutu"
          }
        }
      }
    },
    "Which languages do you speak in your videos? Bombocut downloads only the speech model you need. Captions then run on your iPhone, offline.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakými jazyky ve videích mluvíš? Bombocut stáhne jen model, který potřebuješ. Titulky pak běží v iPhonu, offline."
