    },
    "All updates included": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny aktualizace v ceně"
          }
        }
      }
    },
    "Allow BOMBOCUT to use your photos in Settings > BOMBOCUT > Photos.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol BOMBOCUTu přístup k fotkám v Nastavení > BOMBOCUT > Fotky."
          }
        }
      }
    },
    "Allow Photos access in Settings to save videos.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby šlo ukládat videa, povol v Nastavení přístup k Fotkám."
          }
        }
      }
    },
    "Allow access in Settings to pick clips here, with slide to select. Or pick them in the system picker.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol v Nastavení přístup k fotkám a vybírej klipy tady, klidně tahem prstu. Nebo použij systémový výběr."
          }
        }
      }
    },
    "Always show": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazovat vždy"
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síla"
          }
        }
      }
    },
    "Analyze & stabilize": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzovat a stabilizovat"
          }
        }
      }
    },
    "Analyze again": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzovat znovu"
          }
        }
      }
    },
    "Analyzed by an older version (shake only). Analyze again to also straighten tilting and zoom wobble.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzovala to starší verze (jen otřesy). Analyzuj znovu a vyrovná se i naklánění a houpání."
          }
        }
      }
    },
    "Analyzing shake": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měřím otřesy"
          }
        }
      }
    },
    "Animation": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animace"
          }
        }
      }
    },
    "Any subject": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní objekt"
          }
        }
      }
    },
    "App language": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk aplikace"
          }
        }
      }
    },
    "Apple's built-in translator": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestavěný překladač od Applu"
          }
        }
      }
    },
    "Apple's translator can't translate %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač od Applu neumí jazyk %@."
          }
        }
      }
    },
    "Apple's translator can't translate this. Download the language above to translate it offline.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle překladač od Applu neumí. Stáhni si jazyk nahoře a přelož to offline."
          }
        }
      }
    },
    "Apple's translator can't translate this. The translation model can: download it above.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle překladač od Applu neumí. Překladový model ano, stáhni si ho nahoře."
          }
        }
      }
    },
    "Apple's translator: quick, on your iPhone.": {
      "localizations": {
        "cs": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Překladač od Applu: rychlý, v iPadu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Překladač od Applu: rychlý, v iPhonu."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Apple's translator: quick, on your iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Apple's translator: quick, on your iPhone."
                }
              }
            }
          }
        }
      }
    },
    "Apple's voice isolation, for videos recorded with spatial audio on iPhone 16 and newer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izolace hlasu od Applu, pro videa natočená s prostorovým zvukem na iPhonu 16 a novějším."
          }
        }
      }
    },
