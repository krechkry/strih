          }
        }
      }
    },
    "You can close this and keep editing. The pill at the top shows when they're ready.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel můžeš zavřít a stříhat dál. Až budou titulky hotové, uvidíš to nahoře."
          }
        }
      }
    },
    "You can switch any time in Settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepnout můžeš kdykoli v Nastavení."
          }
        }
      }
    },
    "You can turn this off in the full version. It helps spread the word about BOMBOCUT. If you want, cut it off after export. Thanks!": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
