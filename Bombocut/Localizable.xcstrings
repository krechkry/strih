    "Downloading voice model": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování hlasového modelu"
          }
        }
      }
    },
    "Drag sideways on the preview to find a frame where the subject is clear, then tap Select subject and tap or roughly box it. Bombocut finds it, draws a box you can fix, and follows it through the whole clip.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Táhni prstem do stran po náhledu a najdi snímek, kde je objekt dobře vidět. Pak klepni na Vybrat objekt a klepni na něj, nebo ho zhruba orámuj. Bombocut ho najde, nakreslí rámeček, který můžeš doladit, a sleduje ho celým klipem."
          }
        }
      }
    },
    "Drag the box to fix it, then Track": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolaď rámeček a klepni na Sledovat"
          }
        }
      }
    },
