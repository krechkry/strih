      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní objekt"
          }
        }
      }
    },
    "Make captions first.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív vytvoř titulky."
          }
        }
      }
    },
    "Makes the voice model load fast. Deleting means the next load takes minutes again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky ní se hlasový model načítá rychle. Když ji smažeš, další načtení zase potrvá pár minut."
          }
        }
      }
    },
    "Making the matte…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dělám alfa masku…"
          }
        }
      }
    },
    "Making the transparent video…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dělám průhledné video…"
          }
        }
      }
    },
    "Mask": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maska"
          }
        }
      }
    },
    "Matte": {
      "localizations": {
