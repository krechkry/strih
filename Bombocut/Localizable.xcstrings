    "Sharing failed": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení se nepovedlo"
          }
        }
      }
    },
    "Shows the app's buttons and texts over your video while you edit. The shaded area is what they cover; a title that goes into it lights the layout up orange.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při stříhání ukáže přes video tlačítka a texty sociální sítě. Stínovaná plocha je to, co zakrývají. Když do ní zajede titulek, layout se rozsvítí oranžově."
          }
        }
      }
    },
    "Shows wherever no clip covers the frame: borders, moved or smaller clips, and behind transitions.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vidět všude, kde obraz nezakrývá klip: na okrajích, kolem posunutých nebo zmenšených klipů a za přechody."
          }
        }
      }
    },
    "Shrink / grow": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zúžit / rozšířit"
          }
        }
      }
    },
    "Sign in to iCloud and turn on iCloud Drive to sync projects.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na synchronizaci projektů se přihlas k iCloudu a zapni iCloud Drive."
