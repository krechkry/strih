      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahuji hlasový model"
          }
        }
      }
    },
    "Drag sideways on the preview to find a frame where the subject is clear, then tap Select subject and tap or roughly box it. Bombocut finds it, draws a box you can fix, and follows it through the whole clip.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tažením do stran po náhledu najdi snímek, kde je objekt dobře vidět, pak klepni na Vybrat objekt a klepni na něj nebo ho zhruba ohraničuj. Bombocut ho najde, nakreslí rámeček, který můžeš upravit, a sleduje ho celým klipem."
          }
        }
      }
    },
    "Drag the box to fix it, then Track": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprav rámeček a dej Sledovat"
          }
        }
      }
    },
