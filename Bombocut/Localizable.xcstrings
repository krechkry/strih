    },
    "Word by word": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po slovech"
          }
        }
      }
    },
    "Words it should spell your way, split with commas. Example: Kryštof, BOMBOCUT, PVP": {
      "localizations": {
