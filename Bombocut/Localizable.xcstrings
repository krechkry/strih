    },
    "All updates included": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny aktualizace v ceně"
          }
        }
      }
    },
    "Allow Photos access in Settings to save videos.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ukládání videí povol přístup k Fotkám v Nastavení."
          }
        }
      }
    },
    "Allow access in Settings to pick clips here, with slide to select. Or pick them in the system picker.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol přístup v Nastavení a vybírej klipy tady, i tahem prstu. Nebo je vyber v systémovém výběru."
          }
        }
      }
    },
    "Always show": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazovat vždy"
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síla"
          }
        }
      }
    },
    "Analyze & stabilize": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzovat a stabilizovat"
          }
        }
      }
    },
    "Analyze again": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzovat znovu"
          }
        }
      }
    },
    "Analyzed by an older version (shake only). Analyze again to also straighten tilting and zoom wobble.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzováno starší verzí (jen otřesy). Analyzuj znovu, ať se vyrovná i naklánění a houpání."
          }
        }
      }
    },
    "Analyzing shake": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza otřesů"
          }
        }
      }
    },
    "Animation": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animace"
          }
        }
      }
    },
    "Any subject": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní objekt"
          }
        }
      }
    },
    "App language": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk aplikace"
          }
        }
      }
    },
    "Apple's built-in translator": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestavěný překladač od Applu"
          }
        }
      }
    },
    "Apple's translator can't translate %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač od Applu neumí jazyk %@."
          }
        }
      }
    },
    "Apple's translator can't translate this. Download the language above to translate it offline.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač od Applu tohle neumí. Stáhni jazyk výš a přelož to offline."
          }
        }
      }
    },
    "Apple's translator can't translate this. The translation model can: download it above.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač od Applu tohle přeložit neumí. Překladový model ano: stáhni ho výš."
          }
        }
      }
    },
    "Apple's translator: quick, on your iPhone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač od Applu: rychlý, v iPhonu."
          }
        }
      }
    },
    "Apple's voice isolation, for videos recorded with spatial audio on iPhone 16 and newer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izolace hlasu od Applu, pro videa natočená s prostorovým zvukem na iPhonu 16 a novějším."
          }
        }
      }
    },
    "Apply (%lld)": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít (%lld)"
          }
        }
      }
    },
    "Apply to": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít na"
          }
        }
      }
    },
    "Aqua": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyrkysová"
          }
        }
      }
    },
    "Aspect": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poměr stran"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk"
          }
        }
      }
    },
    "Audio Mix": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Mix"
          }
        }
      }
    },
    "AutoZoom": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoZoom"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky"
          }
        }
      }
    },
    "Automatic subtitles in 25 languages": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické titulky ve 25 jazycích"
          }
        }
      }
    },
    "Automatic subtitles in 25 languages. And all the other features you would expect.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické titulky ve 25 jazycích. A všechny ostatní funkce, který bys čekal."
          }
        }
      }
    },
    "BOMBOCUT can't see your library": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "BOMBOCUT nevidí tvoje fotky"
          }
        }
      }
    },
    "BOMBOCUT end card": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koncová karta BOMBOCUT"
          }
        }
      }
    },
    "BOMBOCUT is made by one filmmaker. Buying it keeps the updates coming, and your feedback actually matters.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "BOMBOCUT dělá jeden filmař. Díky tvému nákupu můžou dál přibývat updaty a na tvojí zpětné vazbě opravdu záleží."
          }
        }
      }
    },
    "BOMBOCUT measures how the camera shakes, tilts and wobbles in this clip (things moving in the shot are ignored), then smooths it out and zooms in slightly to hide the edges.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "BOMBOCUT změří, jak se kamera v klipu třese, naklání a houpe (co se v záběru hýbe, nevadí), pak to vyhladí a lehce přiblíží, aby nebyly vidět okraje."
          }
        }
      }
    },
    "BOMBOCUT measures the camera shake in this clip, then smooths it out and zooms in slightly to hide the edges. Takes a few seconds per minute of footage.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "BOMBOCUT změří otřesy kamery v klipu, vyhladí je a lehce přiblíží obraz, aby nebyly vidět okraje. Zabere to pár sekund na minutu videa."
          }
        }
      }
    },
    "BOMBOCUT sees only the items you allowed. Change it in Settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "BOMBOCUT vidí jen položky, které jsi povolil. Změníš to v Nastavení."
          }
        }
      }
    },
    "BOMBOCUT uses": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "BOMBOCUT zabírá"
          }
        }
      }
    },
