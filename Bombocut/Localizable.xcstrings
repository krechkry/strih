{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ %lld %%": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld %%"
          }
        }
      }
    },
    "%@ translates offline, on your iPhone.": {
      "localizations": {
        "cs": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ překládá offline, přímo v iPadu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ překládá offline, přímo v iPhonu."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ translates offline, on your iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ translates offline, on your iPhone."
                }
              }
            }
          }
        }
      }
    },
    "%@, downloaded once. Wi-Fi recommended.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, stáhne se jen jednou. Radši přes Wi-Fi."
          }
        }
      }
    },
    "%@: imported without sound (%@ isn't supported).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: importováno bez zvuku (%@ není podporovaný)."
          }
        }
      }
    },
    "%@: its video (%@) can't be played on iPhone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: jeho video (%@) iPhone neumí přehrát."
          }
        }
      }
    },
    "%@: no video inside.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: není v něm video."
          }
        }
      }
    },
    "%@: this iPhone can't decode its video (%@).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: tenhle iPhone neumí dekódovat jeho video (%@)."
          }
        }
      }
    },
    "%lld chars": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld znaků"
          }
        }
      }
    },
    "%lld clip": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klip"
          }
        }
      }
    },
    "%lld clips": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klipů"
          }
        }
      }
    },
    "%lld days of your trial left.": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývá %lld den."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývají %lld dny."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývá %lld dní."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zkušební verze: zbývá %lld dní."
                }
              }
            }
          }
        }
      }
    },
    "%lld files couldn't be opened.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se otevřít souborů: %lld."
          }
        }
      }
    },
    "%lld projects, every clip stored once": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektů: %lld, každý klip uložený jen jednou"
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybrán %lld"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybrány %lld"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybráno %lld"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vybráno %lld"
                }
              }
            }
          }
        }
      }
    },
    "1 day of your trial left.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební verze: zbývá poslední den."
          }
        }
      }
    },
    "1 line": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1 řádek"
          }
        }
      }
    },
    "2 lines": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "2 řádky"
          }
        }
      }
    },
    "25 languages": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "25 jazyků"
          }
        }
      }
    },
    "A preset holds the whole look of the text: size, spacing, font, colors, outline, shadow and box. Save makes one from this text; hold a preset to update it with the current look, rename it or delete it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset drží celý vzhled textu: velikost, rozestupy, písmo, barvy, obrys, stín i pozadí. Uložit z tohohle textu udělá nový. Když preset podržíš, můžeš ho aktualizovat podle současného vzhledu, přejmenovat nebo smazat."
          }
        }
      }
    },
    "A preset holds the whole style: layout, font, colors, outline, shadow, box and animation. Save makes one from how your captions look now; hold a preset to update it with the current look or delete it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset drží celý styl: layout, písmo, barvy, obrys, stín, pozadí i animaci. Uložit udělá nový z toho, jak titulky vypadají teď. Když preset podržíš, můžeš ho aktualizovat podle současného vzhledu nebo smazat."
          }
        }
      }
    },
    "A short Made with BOMBOCUT card after your last clip. Thanks for spreading the word!": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátká karta „Made with BOMBOCUT“ po posledním klipu. Díky, že to šíříš dál!"
          }
        }
      }
    },
    "A slow push in or pull out over the whole clip, like a camera move. Switch it on to set it up.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalé přiblížení nebo oddálení přes celý klip, jako jízda kamery. Zapni a nastav si ho."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikaci"
          }
        }
      }
    },
    "About %.0f MB for %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhruba %.0f MB na %@."
          }
        }
      }
    },
    "Above 4096 px only HEVC works.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad 4096 px funguje jen HEVC."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat"
          }
        }
      }
    },
    "Add %lld": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat %lld"
          }
        }
      }
    },
    "Add .cube LUTs from Files (DaVinci Resolve and other apps). Tap the sliders on the one you picked for its strength or to remove it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej .cube LUTy ze Souborů (DaVinci Resolve a další). Klepnutím na posuvníky u vybraného nastavíš sílu nebo ho odebereš."
          }
        }
      }
    },
    "Add .ttf or .otf files from Files. Hold an added font to remove it. Use only fonts you have the rights to.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej písma .ttf nebo .otf ze Souborů. Přidané písmo odebereš podržením. Používej jen písma, ke kterým máš práva."
          }
        }
      }
    },
    "Add LUT": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat LUT"
          }
        }
      }
    },
    "Add a clip to start": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej první klip"
          }
        }
      }
    },
    "Add as a new track": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat jako novou stopu"
          }
        }
      }
